# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Banco MySQL (Hostinger) — obrigatório para painel, catálogo, leads, PDFs e fotos
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Login do painel: AUTH_SECRET assina a sessão; ADMIN_* criam o primeiro administrador (npm run db:setup)
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# WhatsApp Business Cloud API — somente servidor, modo API oficial
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
